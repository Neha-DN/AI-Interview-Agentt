# Frontend environment configuration (Member 1)
# Copy to .env — never commit .env, never put API keys here.

# Base URL of the FastAPI backend. The frontend always calls `${VITE_API_BASE_URL}/api/interview`.
VITE_API_BASE_URL=http://localhost:8000

# true  -> use the local contract-identical mock agent (frontend dev without backend)
# false -> call the real backend
VITE_USE_MOCK_API=true
